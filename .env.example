# Apenas desenvolvimento local; nunca versione .env.
NODE_ENV=development
DATABASE_URL=postgresql://taskflow:taskflow_dev_only@localhost:5433/taskflow?connection_limit=5&pool_timeout=10&connect_timeout=5
DATABASE_URL_TEST=postgresql://taskflow:taskflow_dev_only@localhost:5433/taskflow_test
PORT=3001
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
